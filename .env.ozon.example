# Переменные контейнера Ozon Connect. Не класть в config.yaml и не коммитить значения.
# Контейнер хаба эти имена не читает. Токен хаба MOYSKLAD_TOKEN сюда не подставлять.

# 1 — наружу не пишем (так и задумано в этом выпуске: запись всё равно выключена кодом).
OZON_DRY_RUN=1
# Модули FBS и FBO в этом образе не запускаются, даже если поставить 1.
OZON_FBS_ENABLED=0
OZON_FBO_ENABLED=0

# Своя SQLite на диске /data. serve файл не создаёт. Создаёт команда import.
OZON_DATABASE_URL=sqlite+aiosqlite:////data/ozon.sqlite3
PORT=8080

# Отдельный сотрудник МойСклад с правом чтения ассортимента, не админ и не токен хаба.
# Читает только команда import. serve это значение никуда не отправляет.
OZON_MOYSKLAD_TOKEN=
# Пусто — не задавать. Позже: запросов за 3 с для этого сотрудника, с запасом от лимита.
OZON_MOYSKLAD_RPS=

# Кабинеты через запятую: буквы, цифры, подчёркивание. Пусто — сервис стартует без кабинетов.
OZON_ACCOUNTS=
# OZON_ACCOUNT_SHOP_CLIENT_ID=
# OZON_ACCOUNT_SHOP_API_KEY=
