# Переменные окружения хаба. На Dockhost — панель проекта → «Переменные окружения».
# Локально: cp .env.example .env и docker run --env-file .env …

# МойСклад: токен сотрудника с правами на заказы, отгрузки, контрагентов, печать, доп. поля
MOYSKLAD_TOKEN=
# запросов за 3 с. Пусто — по графику МойСклад для токена пользователя: сейчас 15,
# с 01.12.2026 — 11 (хаб берёт на 1 меньше). Токен решения — 45. Если процессов с одним
# токеном несколько (реплики воркеров), поделите лимит между ними.
MOYSKLAD_RPS=

# 1 — ничего не отправлять и не писать в МойСклад, только журнал (так начинать!); 0 — боевой режим
HUB_DRY_RUN=1

# база: SQLite-файл на постоянном диске (один контейнер) …
HUB_DATABASE_URL=sqlite+aiosqlite:////data/hub.sqlite3
# … или PostgreSQL, когда процессов несколько:
# HUB_DATABASE_URL=postgresql://user:password@host:5432/hub
# all | api | worker | scheduler | bot (раздельные роли, кроме bot, — только с PostgreSQL)
HUB_ROLE=all

# REST API: ключ для заголовка X-Api-Key (длинная случайная строка)
HUB_API_KEY=
# секрет в адресе вебхука https://<домен>/hooks/moysklad/<секрет>
HUB_WEBHOOK_SECRET=
# внешний адрес (домен Dockhost) — для python -m hub webhooks install
HUB_PUBLIC_URL=

# страховочный опрос МойСклад, секунд (0 — только вебхуки)
HUB_POLL_SECONDS=300
# первый старт: подхватить изменения за столько часов назад (0 — только новые)
HUB_LOOKBACK_HOURS=0

# Почта (Яндекс 360: smtp.yandex.ru, 465, пароль приложения)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=0

# Telegram: бот для файлов, уведомлений и алертов
TELEGRAM_BOT_TOKEN=
HUB_ALERT_CHAT=

# Telegram-бот с ответами по МойСклад (Claude, только чтение). Работает, когда заданы все три:
# ключ из console.anthropic.com (поставьте там месячный лимит расходов), TELEGRAM_BOT_TOKEN выше
# и chat id через запятую — кому бот отвечает. Свой id бот подскажет в ответ на любое сообщение.
ANTHROPIC_API_KEY=
HUB_BOT_CHATS=
# модель и глубина: claude-opus-5-5 (по умолчанию) или claude-haiku-5-5 — в разы дешевле, слабее
# на расчётах; effort low | medium | high
HUB_BOT_MODEL=claude-opus-5-5
HUB_BOT_EFFORT=medium

# Второй бот: заказы из закрытого чата-очереди. Токен свой, не TELEGRAM_BOT_TOKEN.
# Публичные чаты не читает. После «да» в очереди создаёт заказ покупателя.
# HUB_DRY_RUN=1 — черновик в лог, в МойСклад не пишет и номер не обещает.
ORDER_BOT_TOKEN=
HUB_ORDER_CHAT=
# часть названия юрлица, как в вопросах справочного бота («Краснояров Данил»)
HUB_ORDER_ORGANIZATION=
